/* Главная обертка на весь экран */
.full-screen-container {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;

    /* Темный фон */
    background-color: rgba(0, 0, 0, 0.85);

    /* Самая главная магия центровки Flexbox */
    display: flex;
    justify-content: center; /* Выравнивание по Вертикали (ось Main) */
    align-items: center;     /* Выравнивание по Горизонтали (ось Cross) */
}

.panel {
    width: 400px;
    padding: 25px;
    background-color: #2b2b2b;
    border-radius: 10px;
    border-color: #555;
    border-width: 1px;
}

.title-label {
    -unity-font-style: bold;
    font-size: 22px;
    color: white;
    -unity-text-align: middle-center;
    margin-bottom: 15px;
}

.status-label {
    font-size: 14px;
    color: #ccc;
    -unity-text-align: middle-center;
    margin-top: 10px;
}

/* Стандартные цвета бара */
.unity-progress-bar__background { background-color: #111; }
.unity-progress-bar__progress { background-color: #4CAF50; margin: 0; }